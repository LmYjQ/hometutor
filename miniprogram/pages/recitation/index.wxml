<view class="container">
  <!-- 作业信息 -->
  <view class="assignment-info">
    <view class="class-tag">{{assignment.class_name}}</view>
    <view class="question">{{assignment.question_title}}</view>
    <view class="deadline">截止时间: {{assignment.deadlineText}}</view>
  </view>

  <!-- 录制区域 -->
  <view class="record-section">
    <!-- 视频预览（录制完成后显示） -->
    <view class="video-container" wx:if="{{videoPath}}">
      <video class="video-preview" src="{{videoPath}}" controls></video>
      <view class="video-overlay">
        <view class="re-record-btn" bindtap="reRecord">重新录制</view>
      </view>
    </view>

    <!-- 摄像头预览和录制（仅用户点过「录制」或「从相册选」之后才显示） -->
    <view class="camera-container" wx:elif="{{showCamera}}">
      <camera
        device-position="{{cameraPosition}}"
        flash="off"
        binderror="onCameraError"
        style="width: 100%; height: 400rpx; border-radius: 16rpx;"
      ></camera>
      <view class="camera-controls" wx:if="{{!isRecording}}">
        <view class="switch-camera-btn" bindtap="switchCamera">
          <text>🔄 翻转</text>
        </view>
      </view>
    </view>

    <!-- 默认状态：两个入口按钮（不直接打开摄像头） -->
    <view class="entry-buttons" wx:elif="{{!videoPath && !showCamera}}">
      <view class="entry-btn record-entry" bindtap="openCameraToRecord">
        <text class="entry-icon">⏺</text>
        <text class="entry-text">录制视频</text>
        <text class="entry-desc">直接录一段背诵视频</text>
      </view>
      <view class="entry-btn album-entry" bindtap="chooseFromAlbum">
        <text class="entry-icon">🖼️</text>
        <text class="entry-text">从相册选择</text>
        <text class="entry-desc">系统相册里的视频</text>
      </view>
      <view class="entry-btn file-entry" bindtap="chooseFromChatFile">
        <text class="entry-icon">💬</text>
        <text class="entry-text">从聊天文件选</text>
        <text class="entry-desc">微信聊天/收藏里的视频</text>
      </view>
    </view>

    <!-- 录制控制（摄像头打开后才显示） -->
    <view class="record-controls" wx:if="{{showCamera && !videoPath}}">
      <view
        class="record-btn {{isRecording ? 'recording' : ''}}"
        bindtap="toggleRecord"
      >
        <text class="record-icon">{{isRecording ? '⏹' : '⏺'}}</text>
        <text class="record-time" wx:if="{{isRecording}}">{{recordTime}}s</text>
        <text class="record-label">{{isRecording ? '停止' : '录制'}}</text>
      </view>

      <!-- 录制中不显示相册入口 -->
      <view class="album-btn" wx:if="{{!isRecording}}" bindtap="chooseFromAlbum">从相册选择</view>
      <view class="album-btn" wx:if="{{!isRecording}}" bindtap="chooseFromChatFile">从聊天文件选</view>
    </view>
  </view>

  <!-- 上传和提交 -->
  <view class="submit-section" wx:if="{{videoPath}}">
    <view class="video-info">
      <text class="info-text">视频已准备好</text>
      <text class="file-size">大小: {{fileSizeText}}</text>
    </view>

    <button
      class="submit-btn"
      bindtap="submitRecitation"
      loading="{{uploading || analyzing}}"
      disabled="{{uploading || analyzing || remainingSubmissions === 0}}"
    >
      <text wx:if="{{uploading}}">上传中...</text>
      <text wx:elif="{{analyzing}}">AI评分中...</text>
      <text wx:elif="{{remainingSubmissions === 0}}">已达提交次数上限</text>
      <text wx:else>提交背诵</text>
    </button>

    <view class="progress-section" wx:if="{{progress > 0}}">
      <progress percent="{{progress}}" stroke-width="6" activeColor="#667eea" backgroundColor="#f0f0f0" active="{{analyzing}}" />
      <text class="progress-text">{{progressText}}</text>

      <!-- 分阶段步骤：抽音频 → 上传 → 语音识别 → AI评分 -->
      <view class="step-list">
        <view class="step-item {{item.status}}" wx:for="{{steps}}" wx:key="key">
          <view class="step-dot">{{item.status === 'done' ? '✓' : item.status === 'active' ? '●' : '○'}}</view>
          <text class="step-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史提交记录 -->
  <view class="history-section" wx:if="{{historySubmissions.length > 0}}">
    <view class="section-title">历史提交</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{historySubmissions}}" wx:key="_id" bindtap="viewResult" data-id="{{item._id}}">
        <view class="history-time">{{item.created_atText}}</view>
        <view class="history-score">
          <text class="score">{{item.score}}分</text>
        </view>
        <view class="history-status {{item.status}}">
          {{item.status === 'graded' ? '已评分' : '评分中'}}
        </view>
      </view>
    </view>
  </view>
</view>
