<view class="container">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 作业信息 -->
  <view class="assignment-header" wx:if="{{assignment && !loading}}">
    <view class="class-tag">{{assignment.class_name}}</view>
    <view class="question">{{assignment.question_title}}</view>
    <view class="meta">
      <text class="deadline">截止: {{assignment.deadlineText}}</text>
      <text class="stats">{{submittedCount}}/{{totalStudentCount}} 人已提交</text>
    </view>
  </view>

  <!-- 已提交学生 -->
  <view class="submissions-section" wx:if="{{!loading && studentStats.length > 0}}">
    <view class="section-title">已提交（{{submittedCount}} 人）</view>
    <view class="submission-list">
      <view class="submission-card"
            wx:for="{{studentStats}}"
            wx:key="student_id"
            bindtap="viewStudentSubmissions"
            data-student-id="{{item.student_id}}"
            data-student-name="{{item.student_name}}">
        <view class="student-info">
          <image class="avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="info">
            <text class="name">{{item.student_name}}</text>
            <text class="submit-count">提交 {{item.submissionCount}} 次 · 最近 {{item.lastScore}} 分</text>
          </view>
        </view>
        <view class="score-info">
          <view class="best-score {{item.bestScore >= 80 ? 'good' : item.bestScore >= 60 ? 'medium' : 'bad'}}">
            最高 {{item.bestScore}}分
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 未提交学生（折叠区） -->
  <view class="not-submitted-section" wx:if="{{!loading && notSubmittedStudents.length > 0}}">
    <view class="section-title" bindtap="toggleNotSubmitted">
      <text>未提交（{{notSubmittedStudents.length}} 人）</text>
      <text class="toggle">{{showNotSubmitted ? '▾' : '▸'}}</text>
    </view>
    <view class="submission-list" wx:if="{{showNotSubmitted}}">
      <view class="submission-card not-submitted"
            wx:for="{{notSubmittedStudents}}"
            wx:key="student_id">
        <view class="student-info">
          <image class="avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="info">
            <text class="name">{{item.student_name}}</text>
            <text class="submit-count missing-text">尚未提交</text>
          </view>
        </view>
        <view class="score-info">
          <view class="best-score zero">—</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 - 完全没人提交 -->
  <view class="empty" wx:if="{{!loading && studentStats.length === 0 && notSubmittedStudents.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">班级还没有学生</text>
  </view>
</view>