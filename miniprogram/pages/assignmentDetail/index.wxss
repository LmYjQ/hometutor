.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
}

.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-text { color: #999; font-size: 28rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { color: #999; font-size: 28rpx; }

/* === 作业信息 === */
.assignment-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 40rpx 30rpx;
}
.class-tag {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.question {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 20rpx;
}
.meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  opacity: 0.9;
}

/* === 共用区段标题 === */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin: 30rpx 30rpx 16rpx;
}
.toggle {
  font-size: 28rpx;
  color: #999;
  font-weight: normal;
}

/* === 学生卡片 === */
.submission-list {
  margin: 0 30rpx;
}
.submission-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.not-submitted { opacity: 0.7; }

.student-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
}
.info { display: flex; flex-direction: column; }
.name { font-size: 28rpx; color: #333; font-weight: 500; }
.submit-count { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.missing-text { color: #ff7a45; }

/* 分数徽章 */
.best-score {
  background: #f0f0f0;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.best-score.good { background: #e6f7ee; color: #13a363; }
.best-score.medium { background: #fff7e6; color: #d4880a; }
.best-score.bad { background: #ffeded; color: #ff4d4f; }
.best-score.zero { background: #f5f5f5; color: #bbb; }