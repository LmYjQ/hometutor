<view class="container">
  <view class="header">
    <view class="user-info" bindtap="goToProfile">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="info">
        <text class="name">{{userInfo.name}}</text>
        <text class="role">学生</text>
      </view>
    </view>
    <view class="stats">
      <view class="stat-item">
        <text class="num">{{classCount}}</text>
        <text class="label">班级数</text>
      </view>
      <view class="stat-item">
        <text class="num">{{pendingCount}}</text>
        <text class="label">待完成</text>
      </view>
    </view>
  </view>

  <view class="section-title">
    待完成作业
    <text class="refresh-btn" bindtap="refreshAssignments">刷新</text>
  </view>

  <view class="debug-info" wx:if="{{debugInfo}}">
    <text>{{debugInfo}}</text>
  </view>

  <!-- 批次化作业列表：每个批次可折叠，默认只展开最新 -->
  <view class="batch-list" wx:if="{{batches.length > 0}}">
    <view class="batch-card" wx:for="{{batches}}" wx:key="_id">
      <view class="batch-header" bindtap="toggleBatch" data-id="{{item._id}}">
        <view class="batch-title-area">
          <text class="batch-icon">{{item.isLegacy ? '📦' : '📚'}}</text>
          <view class="batch-text">
            <text class="batch-title">{{item.title}}</text>
            <text class="batch-meta">{{item.created_atText}} · {{item.assignment_count}} 题</text>
          </view>
        </view>
        <text class="batch-chevron">{{expandedBatchIdsMap[item._id] ? '▼' : '▶'}}</text>
      </view>

      <view wx:if="{{expandedBatchIdsMap[item._id]}}" class="assignment-list">
        <view class="assignment-card"
              wx:for="{{item.assignments}}"
              wx:for-item="as"
              wx:key="_id"
              bindtap="goToRecitation"
              data-id="{{as._id}}">
          <view class="assignment-header">
            <text class="class-name">{{as.class_name}}</text>
            <text class="deadline" wx:if="{{as.isOverdue}}" style="color: #ff4d4f;">已截止</text>
            <text class="deadline" wx:else>截止: {{as.deadlineText}}</text>
          </view>
          <view class="assignment-title">{{as.question_title}}</view>
          <view class="assignment-status" wx:if="{{as.submitted}}">
            <text class="status-tag completed">已提交</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{!debugInfo}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂时没有待完成的作业</text>
  </view>

  <view class="section-title" wx:if="{{classes.length > 0}}">我加入的班级</view>
  <view class="class-list" wx:if="{{classes.length > 0}}">
    <view class="class-item" wx:for="{{classes}}" wx:key="_id">
      <text class="class-name">{{item.name}}</text>
      <text class="teacher-name">{{item.teacher_name}} 老师</text>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="join-btn" bindtap="goToJoinClass">+ 加入班级</button>
  </view>
</view>