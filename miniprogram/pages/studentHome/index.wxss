.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  margin-right: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.role {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.stats {
  display: flex;
  gap: 60rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .num {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.stat-item .label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.section-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.refresh-btn {
  font-size: 26rpx;
  font-weight: normal;
  color: #11998e;
  padding: 8rpx 20rpx;
  border: 1px solid #11998e;
  border-radius: 20rpx;
}

.debug-info {
  margin: 0 30rpx 20rpx;
  padding: 20rpx;
  background: #fff3cd;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #856404;
  white-space: pre-wrap;
  word-break: break-all;
}

.assignment-list {
  padding: 0 30rpx;
}

.assignment-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.assignment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.assignment-card .class-name {
  font-size: 24rpx;
  color: #666;
}

.assignment-card .deadline {
  font-size: 22rpx;
  color: #999;
}

.assignment-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}

.assignment-status {
  margin-top: 16rpx;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-tag.completed {
  background: #e6fffb;
  color: #13c2c2;
}

.class-list {
  padding: 0 30rpx;
}

.class-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.class-item .class-name {
  font-size: 28rpx;
  color: #333;
}

.class-item .teacher-name {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.bottom-actions {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
}

.join-btn {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 60rpx;
  height: 100rpx;
  line-height: 100rpx;
  border: none;
}

/* ===== 作业批次（学生端） ===== */
.batch-list {
  padding: 0 30rpx 30rpx;
}
.batch-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.batch-title-area {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.batch-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.batch-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.batch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.batch-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.batch-chevron {
  font-size: 24rpx;
  color: #999;
}

.batch-card .assignment-list {
  padding: 0;
  background: #fafafa;
}
.batch-card .assignment-card {
  background: #fff;
  border-radius: 0;
  margin: 16rpx 30rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0f0f0;
}
.batch-card .assignment-card:last-child {
  margin-bottom: 16rpx;
}
