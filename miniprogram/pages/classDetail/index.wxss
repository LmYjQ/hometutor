.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.class-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.class-meta {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.student-count {
  border-bottom: 1rpx dashed rgba(255,255,255,0.5);
}

.copy-btn {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.publish-btn {
  display: inline-block;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
  margin-left: 20rpx;
}

.section-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.assignment-list {
  padding: 0 30rpx 30rpx;
}

.assignment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.assignment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.question-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.status {
  font-size: 24rpx;
}

.assignment-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

.student-list {
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
  padding: 10rpx 0;
}

.student-card {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.student-card:last-child { border-bottom: none; }
.student-card .avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
}
.student-card .info { display: flex; flex-direction: column; min-width: 0; }
.student-card .name { font-size: 28rpx; color: #333; font-weight: 500; }
.student-card .openid {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 480rpx;
}

.student-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 30rpx;
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
}

.toggle { font-size: 22rpx; margin-left: 6rpx; opacity: 0.7; }

/* ===== 作业批次（v2） ===== */
.batch-list {
  padding: 0 30rpx 30rpx;
}
.batch-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.batch-title-area {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.batch-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.batch-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.batch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.batch-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.batch-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.batch-menu-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  border-radius: 50%;
}
.batch-menu-btn:active {
  background: #f5f5f5;
}
.batch-chevron {
  font-size: 24rpx;
  color: #999;
}

.batch-card .assignment-list {
  padding: 0;
  background: #fafafa;
}
.batch-card .assignment-card {
  background: #fff;
  border-radius: 0;
  margin: 0 30rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid #f0f0f0;
}
.batch-card .assignment-card:last-child {
  margin-bottom: 16rpx;
}
