# ============ Server ============
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============ 微信小程序 ============
# 公众平台 → 开发管理 → 开发设置
WECHAT_APPID=
WECHAT_SECRET=

# ============ JWT 鉴权 ============
# 生成命令: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ============ Postgres ============
POSTGRES_USER=hometutor
POSTGRES_PASSWORD=hometutor_dev
POSTGRES_DB=hometutor
DATABASE_URL=postgres://hometutor:hometutor_dev@postgres:5432/hometutor

# ============ SiliconFlow AI ============
# https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============ CloudBase（阶段 1 仍需）============
# 公众平台 → 云开发 → 环境 → 环境 ID
CLOUDBASE_ENV_ID=hometutor-dev-d2gz5nh53c67ecd73

# ============ 业务配置 ============
MAX_SUBMISSIONS_PER_ASSIGNMENT=10
INVITE_SEED_CODE=TEACH2026

# ============ Cloudflare Tunnel ============
TUNNEL_TOKEN=